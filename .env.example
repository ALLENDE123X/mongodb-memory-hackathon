# MongoDB Atlas sandbox connection string (Atlas Agent Engine sandbox cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recursive_harness
# Anthropic API key for reviewer + watcher agents
ANTHROPIC_API_KEY=
# Voyage AI key for semantic memory embeddings
VOYAGE_API_KEY=
# Raindrop telemetry (optional; write-only, no-op when unset)
RAINDROP_WRITE_KEY=
RAINDROP_DASHBOARD_URL=
# RAINDROP_SAMPLE=1.0
# RAINDROP_DISABLE=claim_scrub,payer_outcome,rule_proposal,gate_verdict,ruleset_promotion
# Rule consolidation step in the loop (default on); 0 skips it and its extra watcher call per payer
# CONSOLIDATE=1
# Max in-flight model calls across all threads (default 6); rate-limit/overload errors back off exponentially
# LLM_CONCURRENCY=6
