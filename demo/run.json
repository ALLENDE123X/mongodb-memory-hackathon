  "rules": [
    {
      "rule_id": "R-001",
      "payer": "BAYVIEW",
      "description": "BAYVIEW bundles venipuncture 36415 into the payment for a same-claim lab panel (e.g., 80053) and denies it with CARC 97.",
      "status": "promoted",
      "iteration": 0,
      "version": 1,
      "carc": "97",
      "when": [
        {
          "field": "payer",
          "op": "eq",
          "value": "BAYVIEW"
        },
        {
          "field": "cpts",
          "op": "contains",
          "value": "36415"
        },
        {
          "field": "cpts",
          "op": "contains_any",
          "value": [
            "80053",
            "80048",
            "80061",
            "85025",
            "83036"
          ]
        }
      ],
      "evidence": [
        "run1:0:CLM-016"
      ],
      "rejection_reason": null
    },
    {
      "rule_id": "R-002",
      "payer": "NORTHSTAR",
      "description": "NORTHSTAR rejects modifier 59 as inconsistent with the procedure (CARC 4) and expects the X{EPSU} subset modifiers (e.g., XU) instead.",
      "status": "promoted",
      "iteration": 0,
      "version": 2,
      "carc": "4",
      "when": [
        {
          "field": "payer",
          "op": "eq",
          "value": "NORTHSTAR"
        },
        {
          "any_line": [
